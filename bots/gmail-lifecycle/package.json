{
  "name": "gmail-lifecycle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "secrets:push": "wrangler secret bulk .dev.vars",
    "typecheck": "tsc --noEmit",
    "db:apply": "wrangler d1 execute gmail-lifecycle --file=./schema.sql --remote",
    "db:apply:local": "wrangler d1 execute gmail-lifecycle --file=./schema.sql --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251101.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
