# clawbot environment configuration. Copy to .env and fill in.
# All values are optional; defaults shown.

# HTTP server (inside container)
CLAW_PORT=8080
CLAW_HOST=0.0.0.0

# Host-side port mapping (browser/LAN faces this one)
CLAW_HOST_PORT=8765

# Data persistence (inside container path; bind-mounted to host in compose.yaml)
CLAW_DATA_DIR=/app/bots/clawbot/data

# iLink protocol
ILINK_BOT_TYPE=3
CLAW_BOT_AGENT=clawbot/0.1.0

# Registry override (also used by Makefile)
REGISTRY_URL=192.168.0.110:5000
TAG=latest

# Worker endpoints. CLAW_WORKER_SECRET must be set on BOTH sides:
#   - Each Worker: `pnpm wrangler secret put CLAW_WORKER_SECRET`
#   - Here:        the same value
# Without it the Worker's /ilink endpoint returns 503 (fails closed).
# Generate one with:  openssl rand -hex 32
WORKER_URL_KATAKANA=https://katakana-bot.<your-subdomain>.workers.dev/ilink
WORKER_URL_CTXD=https://ctxd-bot.<your-subdomain>.workers.dev/ilink
CLAW_WORKER_SECRET=
