# stake-odds environment configuration. Copy to .env and fill in.

# Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Topic thread ID in a group with topics enabled. Leave empty for General/default.
TELEGRAM_MESSAGE_THREAD_ID=

# Stake credentials — must be harvested from a browser on the SAME
# network exit IP as the bot (e.g. your home Pi). cf_clearance is bound
# to the IP + User-Agent that solved the Cloudflare challenge.
STAKE_ACCESS_TOKEN=
STAKE_CF_CLEARANCE=
STAKE_USER_AGENT=
STAKE_SESSION_COOKIE=

# Stake request tuning (optional)
STAKE_ACCEPT_LANGUAGE=zh-CN,zh;q=0.9
STAKE_X_LANGUAGE=zh
SPORT_SLUG=soccer
GROUP=threeway

# Monitoring behaviour
#   Comma-separated substring match against the popular tournament name.
#   When no tournament matches, the cycle idles silently.
TOURNAMENT_KEYWORD=world cup,世界杯,fifa
ODDS_CHANGE_THRESHOLD=0.10
POLL_INTERVAL_MS=600000
JITTER_MAX_MS=90000
CREDENTIAL_ALERT_COOLDOWN_MS=3600000

# HTTP server (inside container)
STAKE_ODDS_PORT=8080
STAKE_ODDS_HOST=0.0.0.0

# Host-side port mapping (browser/LAN faces this one)
STAKE_ODDS_HOST_PORT=8766

# Data persistence (inside container path; bind-mounted to host in compose.yaml)
STAKE_ODDS_DATA_DIR=/app/services/stake-odds/data

# Registry override (also used by Makefile)
REGISTRY_URL=192.168.0.110:5000
TAG=latest
