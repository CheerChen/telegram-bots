# herdbot environment configuration. Copy to .env and fill in.
# All values stay on the Pi — never committed, never in CI.

# Telegram (reuse the ctxd-bot token; webhook must be deleted first)
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_ID=

# Agent SDK — two modes:
#
# Mode A: DashScope Anthropic-compatible endpoint (Qwen models, pay-per-token)
#   Set ANTHROPIC_AUTH_TOKEN to your DashScope key, leave ANTHROPIC_API_KEY empty.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=sk-xxx
ANTHROPIC_BASE_URL=https://dashscope-intl.aliyuncs.com/apps/anthropic
CLAUDE_MODEL=qwen3.7-plus
#
# Mode B: Native Anthropic API (Claude models)
#   Set ANTHROPIC_API_KEY, leave ANTHROPIC_AUTH_TOKEN and ANTHROPIC_BASE_URL empty.
#   CLAUDE_MODEL can be a Claude model name or left unset for the SDK default.
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=
# CLAUDE_MODEL=

# ctxd credentials (the "hands")
# GitHub PR: classic PAT with repo scope.
#   https://github.com/settings/tokens/new
#   For SAML-protected orgs, authorize the token for that org.
GITHUB_TOKEN=
# Slack: user token (xoxp-...)
SLACK_TOKEN=
# Atlassian (Jira + Confluence share the same creds)
ATLASSIAN_BASE_URL=https://xxx.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# Session control
# Idle timeout before auto page-turn (ms). Default: 2 hours.
# HERD_IDLE_TIMEOUT_MS=7200000

# Owner alerting. Defaults to ALLOWED_CHAT_ID if unset.
# ALERT_CHAT_ID=

# Registry override (also used by Makefile)
REGISTRY_URL=192.168.0.110:5000
TAG=latest
