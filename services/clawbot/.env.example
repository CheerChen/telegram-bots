# clawbot environment configuration. Copy to .env and fill in.
# All values are optional; defaults shown.

# HTTP server (inside container)
CLAW_PORT=8080
CLAW_HOST=0.0.0.0

# Host-side port mapping (browser/LAN faces this one)
CLAW_HOST_PORT=8765

# Data persistence (inside container path; bind-mounted to host in compose.yaml)
CLAW_DATA_DIR=/app/bots/clawbot/data

# iLink protocol
ILINK_BOT_TYPE=3
CLAW_BOT_AGENT=clawbot/0.1.0

# LLM model pool — comma-separated DashScope API keys.
# At startup, clawbot fetches the model catalog (GET /api/v1/models?capabilities=TG),
# filters to pure-text chat models (excludes VU/coder/character/mt/dated-snapshots),
# sorts by published_time descending (newest first), and falls back across models
# on 403 (quota exhausted) / 401 / 404. Transient errors (429/5xx/timeout) retry
# once then fall back. Disabled models stay disabled until container restart.
LLM_API_KEYS=sk-xxx
# Optional: override DashScope API endpoints (defaults shown)
# LLM_API_BASE_URL=https://dashscope-intl.aliyuncs.com
# LLM_COMPAT_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Registry override (also used by Makefile)
REGISTRY_URL=192.168.0.110:5000
TAG=latest

# Worker endpoint. CLAW_WORKER_SECRET must be set on BOTH sides:
#   - Each Worker: `pnpm wrangler secret put CLAW_WORKER_SECRET`
#   - Here:        the same value
# Without it the Worker's /ilink endpoint returns 503 (fails closed).
# Generate one with:  openssl rand -hex 32
WORKER_URL_CTXD=https://ctxd-bot.<your-subdomain>.workers.dev/ilink
CLAW_WORKER_SECRET=

# Owner alerting (optional). When set, clawbot sends a Telegram message on
# WeChat session expiry so recovery doesn't depend on noticing silence.
# Reuse any bot token that can DM you (e.g. the stagewatch bot's).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# URL shown in the alert for where to re-scan the QR (LAN web UI).
CLAW_UI_URL=http://pi:8765
